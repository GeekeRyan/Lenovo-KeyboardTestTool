<script>
    (function(){
        // 按键映射与状态管理
        const allKeys = document.querySelectorAll('.key');
        const totalKeysCount = allKeys.length;
        document.getElementById('totalKeysCount').innerText = totalKeysCount;

        const keyElementsMap = new Map();   // code -> DOM
        let testedSet = new Set();           // 已触发过（绿色）
        let activeKeys = new Set();          // 当前按住的键（用于active高亮）
        let totalKeystrokes = 0;
        const totalStrokesSpan = document.getElementById('totalStrokes');

        // 长按定时器管理 + 物理按下状态标志（防止重复keydown重置计时器）
        let longPressTimers = new Map();     // code -> timeoutId
        let physicalPressState = new Map();  // code -> boolean (是否物理按住中，用于忽略重复keydown)
        const LONG_PRESS_THRESHOLD = 600;

        // 建立映射
        allKeys.forEach(keyEl => {
            const codeVal = keyEl.getAttribute('data-code');
            if (codeVal) keyElementsMap.set(codeVal, keyEl);
        });

        function updateStats() {
            const testedCount = testedSet.size;
            const percent = Math.round((testedCount / totalKeysCount) * 100);
            document.getElementById('testedCount').innerText = testedCount;
            document.getElementById('percentValue').innerText = percent + '%';
        }

        function markKeyAsTested(code) {
            const keyDiv = keyElementsMap.get(code);
            if (keyDiv && !testedSet.has(code)) {
                testedSet.add(code);
                keyDiv.classList.add('tested');
                updateStats();
            }
        }

        function startBlinking(code) {
            const keyDiv = keyElementsMap.get(code);
            if (keyDiv && !keyDiv.classList.contains('blink')) {
                keyDiv.classList.add('blink');
            }
        }

        function stopBlinking(code) {
            const keyDiv = keyElementsMap.get(code);
            if (keyDiv && keyDiv.classList.contains('blink')) {
                keyDiv.classList.remove('blink');
            }
        }

        function clearLongPressTimer(code) {
            if (longPressTimers.has(code)) {
                clearTimeout(longPressTimers.get(code));
                longPressTimers.delete(code);
            }
        }

        // 按键按下（物理按下，只应在第一次按下时执行完整逻辑）
        function pressKey(code) {
            const keyDiv = keyElementsMap.get(code);
            if (!keyDiv) return;

            // 标记已测试（绿色永久）
            if (!testedSet.has(code)) markKeyAsTested(code);

            // 添加 active 样式（按下瞬间高亮）
            if (!activeKeys.has(code)) {
                activeKeys.add(code);
                keyDiv.classList.add('active');
            }

            // 如果当前已经是物理按住状态（重复keydown，如长按时自动重复触发），则不再重新设置计时器
            if (physicalPressState.get(code) === true) {
                return;
            }

            // 标记物理按下
            physicalPressState.set(code, true);

            // 清除之前的计时器（确保没有残留）
            clearLongPressTimer(code);
            // 停止可能残留的闪烁
            stopBlinking(code);

            // 启动长按计时器：超过阈值后开始闪烁
            const timer = setTimeout(() => {
                // 再次确认当前依然是物理按住状态
                if (physicalPressState.get(code) === true) {
                    startBlinking(code);
                }
                longPressTimers.delete(code);
            }, LONG_PRESS_THRESHOLD);
            longPressTimers.set(code, timer);
        }

        // 按键松开
        function releaseKey(code) {
            const keyDiv = keyElementsMap.get(code);
            if (!keyDiv) return;

            // 移除 active 样式
            if (activeKeys.has(code)) {
                activeKeys.delete(code);
                keyDiv.classList.remove('active');
            }

            // 重置物理按下标志
            physicalPressState.set(code, false);

            // 停止闪烁
            stopBlinking(code);
            // 清除长按计时器
            clearLongPressTimer(code);
        }

        function incrementStrokeCounter() {
            totalKeystrokes++;
            totalStrokesSpan.innerText = totalKeystrokes;
        }

        function resetTest() {
            // 清除所有按键的状态
            for (let [code, el] of keyElementsMap.entries()) {
                stopBlinking(code);
                clearLongPressTimer(code);
                physicalPressState.set(code, false);
                if (activeKeys.has(code)) {
                    el.classList.remove('active');
                    activeKeys.delete(code);
                }
                el.classList.remove('tested');
            }
            testedSet.clear();
            totalKeystrokes = 0;
            totalStrokesSpan.innerText = "0";
            updateStats();
        }

        // 全局键盘事件（捕获阶段）
        window.addEventListener('keydown', function(e) {
            const code = e.code;
            // 阻止浏览器默认行为，避免干扰
            const preventList = [
                'F1','F2','F3','F4','F5','F6','F7','F8','F9','F10','F11','F12',
                'Tab','PrintScreen','ScrollLock','Pause','Insert','Delete','Home','End','PageUp','PageDown',
                'ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Backspace','Enter','Escape','Space','ContextMenu',
                'CapsLock','NumLock','Backquote','Minus','Equal','BracketLeft','BracketRight','Backslash',
                'Semicolon','Quote','Comma','Period','Slash','NumpadEnter'
            ];
            if (preventList.includes(code) || code.startsWith('Key') || code.startsWith('Digit') || code.startsWith('Numpad') ||
                code === 'ShiftLeft' || code === 'ShiftRight' || code === 'ControlLeft' || code === 'ControlRight' ||
                code === 'AltLeft' || code === 'AltRight' || code === 'MetaLeft' || code === 'MetaRight') {
                e.preventDefault();
            }
            if (keyElementsMap.has(code)) {
                pressKey(code);
                incrementStrokeCounter();
            }
            e.stopPropagation();
        }, true);

        window.addEventListener('keyup', function(e) {
            const code = e.code;
            if (keyElementsMap.has(code)) {
                releaseKey(code);
            }
            e.preventDefault();
            e.stopPropagation();
        }, true);

        // 鼠标点击虚拟按键模拟测试（不影响长按逻辑）
        allKeys.forEach(key => {
            key.addEventListener('click', () => {
                const code = key.getAttribute('data-code');
                if (code && keyElementsMap.has(code)) {
                    if (!testedSet.has(code)) markKeyAsTested(code);
                    // 模拟瞬间高亮
                    key.classList.add('active');
                    setTimeout(() => {
                        if (!activeKeys.has(code)) key.classList.remove('active');
                    }, 100);
                    incrementStrokeCounter();
                }
            });
        });

        // 重置按钮
        document.getElementById('resetTestBtn').addEventListener('click', resetTest);

        // 窗口失焦时，清除所有按键的高亮、闪烁和计时器
        window.addEventListener('blur', () => {
            for (let [code, el] of keyElementsMap.entries()) {
                if (activeKeys.has(code)) {
                    el.classList.remove('active');
                    activeKeys.delete(code);
                }
                stopBlinking(code);
                clearLongPressTimer(code);
                physicalPressState.set(code, false);
            }
        });

        updateStats();
        console.log('键盘测试工具已启动，长按超过0.6秒按键将稳定闪烁红色/橙色警告');
    })();
</script>
</body>
</html>
